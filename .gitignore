# （这两个是内嵌到 HTML 的构建产物，运行必需，必须入库）
/data/
/output/
*.pyc
__pycache__/
.venv/
venv/

# 平台元数据 / 本地注册表
_meta.json
.skills_store_lock.json

# 本地状态与工作日志
.workbuddy/
.DS_Store
Thumbs.db

